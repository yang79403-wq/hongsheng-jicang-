<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#6d1712"><title>洪盛集藏｜钱币收藏资料与交流平台</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@600;700;900&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet"><style>:root{--r:#6d1712;--r2:#8b241b;--g:#b99550;--g2:#e2c57e;--paper:#fbf8f1;--cream:#f4ead9;--ink:#2b2521;--muted:#756b61;--line:#dfd0b8;--white:#fffdf9;--dark:#24100c;--shadow:0 12px 34px rgba(58,30,18,.09)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:"Noto Sans SC",-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",Arial,sans-serif;line-height:1.7}.wrap{width:min(1180px,92vw);margin:auto}.top{background:#241512;color:#d8c39a;padding:7px 12px;text-align:center;font-size:12px}.hero{position:relative;overflow:hidden;color:#fff;background:radial-gradient(circle at 84% 20%,rgba(226,197,126,.2),transparent 28%),linear-gradient(135deg,#3d0906 0%,#701811 53%,#430a07 100%);padding:34px 0 42px}.heroGrid{display:grid;grid-template-columns:1.08fr .92fr;gap:30px;align-items:center}.eyebrow{display:inline-block;border:1px solid #e2c57e66;border-radius:999px;padding:5px 12px;color:#f1d894;background:#ffffff09;font-size:11px;font-weight:700;letter-spacing:1px}.brand,.heroTitle,.sectionTitle,.categoryTitle,.card h3,.notice h2{font-family:"Noto Serif SC","Songti SC","STSong","SimSun",serif}.brand{margin:14px 0 2px;color:#f3d88f;font-size:clamp(40px,6vw,68px);font-weight:900;line-height:1.08;letter-spacing:2px}.brandSub{color:#ead39d;font-size:14px;letter-spacing:2px}.heroTitle{font-size:clamp(23px,3vw,32px);margin:18px 0 7px;font-weight:700}.heroLead{color:#eadfd2;font-size:14px;line-height:1.95;max-height:145px;overflow:hidden;white-space:pre-line}.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.tag{padding:4px 10px;border:1px solid #f0d69145;border-radius:999px;background:#ffffff0a;color:#f3dfaa;font-size:11px}.heroActions{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border-radius:9px;padding:10px 16px;font-size:13px;font-weight:800}.btnGold{background:linear-gradient(135deg,#e1c47a,#b78f46);color:#35100c;box-shadow:0 8px 20px #00000018}.btnLight{color:#fff;border:1px solid #ffffff42;background:#ffffff0b}.coinScene{position:relative;min-height:250px}.coin{position:absolute;border-radius:50%;display:grid;place-items:center;font-family:serif;font-weight:900;color:#5d3b17;text-shadow:0 1px #f8d98a;border:8px double #7e571f;background:radial-gradient(circle at 35% 30%,#f3d37c,#b98635 58%,#704616);box-shadow:0 18px 35px #17080570}.coin:after{content:"";position:absolute;inset:17%;border:2px solid #6d481c;border-radius:50%;opacity:.7}.coin.big{width:205px;height:205px;right:30px;top:8px;font-size:42px;transform:rotate(-10deg)}.coin.small{width:120px;height:120px;right:0;bottom:0;font-size:27px;transform:rotate(12deg)}.note{position:absolute;right:65px;bottom:2px;width:245px;height:100px;background:linear-gradient(135deg,#d7b889,#f1dcb7);border:5px solid #a17a4b;transform:rotate(5deg);box-shadow:0 15px 30px #17080555;display:grid;place-items:center;color:#633f24;font-family:serif;font-size:25px;font-weight:900}.nav{position:sticky;top:0;z-index:20;background:#fffdf9ef;backdrop-filter:blur(14px);border-bottom:1px solid var(--line);box-shadow:0 4px 16px #3d21120b}.navInner{display:flex;overflow-x:auto;scrollbar-width:none;min-height:54px}.navInner::-webkit-scrollbar{display:none}.navBrand{display:flex;align-items:center;color:var(--r);font-weight:900;padding:12px 18px 12px 0;white-space:nowrap}.navBrand:before{content:"藏";display:grid;place-items:center;width:26px;height:26px;margin-right:7px;border:1px solid var(--g);border-radius:50%;font-family:serif;color:var(--g);font-size:13px}.nav a{display:flex;align-items:center;padding:13px 15px;color:#513c33;text-decoration:none;font-size:13px;font-weight:700;white-space:nowrap;border-bottom:2px solid transparent}.nav a:hover{color:var(--r);border-bottom-color:var(--g)}.section{padding:38px 0}.sectionTitle{color:var(--r);font-size:clamp(27px,4vw,38px);margin:0;line-height:1.25}.kicker{font-size:10px;color:var(--g);letter-spacing:2.5px;font-weight:900}.sub{color:var(--muted);font-size:13px;margin:6px 0 18px}.rule{height:1px;background:linear-gradient(90deg,var(--g),var(--line),transparent);margin:12px 0 22px}.panel{background:linear-gradient(145deg,#fffdf9,#f7eddf);border:1px solid var(--line);border-radius:20px;padding:24px;box-shadow:0 10px 30px #3a1f1208}.categoryTiles{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}.tile{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:145px;text-align:center;text-decoration:none;color:var(--ink);background:#fffdf9;border:1px solid var(--line);border-radius:13px;padding:16px 9px;box-shadow:0 7px 20px #3d22100a;transition:.2s}.tile:hover{transform:translateY(-3px);border-color:var(--g);box-shadow:0 14px 28px #3d221014}.tile.primary{background:linear-gradient(145deg,#7a1812,#4b0d09);color:#fff1c9;border-color:#9f5d2e}.tileIcon{font-size:37px;margin-bottom:8px}.tileTitle{font-family:"Noto Serif SC",serif;font-size:17px;font-weight:800}.tileMore{margin-top:5px;font-size:11px;color:inherit;opacity:.8}.contentGrid{display:grid;grid-template-columns:1.25fr .9fr .9fr;gap:16px;margin-top:18px}.miniPanel{background:#fffdf9;border:1px solid var(--line);border-radius:15px;padding:18px}.miniHead{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:9px;margin-bottom:10px}.miniHead h3{margin:0;color:var(--r);font-family:"Noto Serif SC",serif;font-size:20px}.miniHead a{font-size:11px;color:var(--r);text-decoration:none}.marketTable{width:100%;border-collapse:collapse;font-size:12px}.marketTable th,.marketTable td{padding:8px 5px;border-bottom:1px solid #eee3d3;text-align:left}.marketTable th{color:var(--muted);font-weight:700}.knowledgeList,.serviceList{margin:0;padding-left:18px;font-size:13px;color:#5f554c}.knowledgeList li,.serviceList li{margin:7px 0}.categoryBlock{margin-top:24px}.categoryHead{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #eadfca;padding-bottom:8px;margin-bottom:12px}.categoryTitle{margin:0;color:#4d2119;font-size:21px}.count{font-size:11px;color:#8b7c70}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.card{background:var(--white);border:1px solid #e2d6c4;border-radius:13px;overflow:hidden;box-shadow:var(--shadow);transition:.2s}.card:hover{transform:translateY(-3px);border-color:#d2b77c}.card a{text-decoration:none;color:inherit}.card img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;background:#eee7dc}.body{padding:12px 14px 15px}.meta{font-size:10px;color:#8a7c70;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card h3{margin:4px 0 5px;color:#541a13;font-size:16px;line-height:1.45}.text{font-size:12px;color:#6f655d;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.8em}.price{color:var(--r);font-size:13px;font-weight:900;margin-top:4px}.more{display:inline-block;margin-top:9px;color:var(--r);font-size:12px;font-weight:900}.notice{border:1px solid #ddc486;border-radius:18px;background:linear-gradient(145deg,#fff9ed,#f5e8d2);padding:24px;box-shadow:var(--shadow)}.notice h2{color:var(--r);margin:3px 0 9px;font-size:28px}.notice p{margin:5px 0;color:#655b51;font-size:13px}.notice strong{color:var(--r)}.important{display:grid;grid-template-columns:repeat(4,1fr);gap:0;background:#fff8e9;border:1px solid #e4d0a4;border-radius:15px;overflow:hidden;margin-top:22px}.important>div{padding:15px;border-right:1px solid #eadabc}.important>div:last-child{border-right:0}.important b{display:block;color:#5a241a;margin-bottom:3px}.important span{font-size:11px;color:#74685d}.footer{background:#240f0c;color:#c4b3a1;padding:38px 14px 32px;margin-top:20px}.footerGrid{width:min(1180px,92vw);margin:auto;display:grid;grid-template-columns:1fr 1fr 1fr;gap:25px}.footer h3{margin:0 0 8px;color:#e5c87d;font-family:"Noto Serif SC",serif}.footer a{color:#d4c1aa;text-decoration:none;font-size:12px}.footer p{font-size:12px;margin:5px 0}.copy{text-align:center;border-top:1px solid #51352c;margin-top:25px;padding-top:15px;font-size:11px;color:#9f8d7c}@media(max-width:1050px){.categoryTiles{grid-template-columns:repeat(3,1fr)}.cards{grid-template-columns:repeat(3,1fr)}.contentGrid{grid-template-columns:1fr 1fr}.marketBox{grid-column:1/-1}}@media(max-width:760px){.heroGrid{grid-template-columns:1fr}.coinScene{min-height:210px}.coin.big{width:155px;height:155px;right:80px}.coin.small{width:95px;height:95px;right:5px}.note{width:190px;height:78px;right:40px;font-size:20px}.categoryTiles{grid-template-columns:repeat(2,1fr)}.cards{grid-template-columns:repeat(2,1fr)}.contentGrid{grid-template-columns:1fr}.important{grid-template-columns:1fr 1fr}.important>div:nth-child(2){border-right:0}.important>div{border-bottom:1px solid #eadabc}.footerGrid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.wrap{width:min(94vw,1180px)}.brand{font-size:38px}.hero{padding:28px 0 35px}.heroTitle{font-size:22px}.heroLead{max-height:180px}.categoryTiles{grid-template-columns:repeat(2,1fr);gap:9px}.tile{min-height:122px}.tileIcon{font-size:30px}.tileTitle{font-size:15px}.cards{grid-template-columns:1fr}.panel{padding:17px;border-radius:16px}.important{grid-template-columns:1fr}.important>div{border-right:0!important}.footerGrid{grid-template-columns:1fr}.section{padding:30px 0}}
</style></head><body><div id="top" class="top"></div><header class="hero"><div class="wrap heroGrid"><div><span class="eyebrow">🏮 HONGSHENG COLLECTION · FUJIAN</span><h1 id="brand" class="brand"></h1><div class="brandSub">钱币收藏资料与交流平台</div><h2 id="heroTitle" class="heroTitle"></h2><p id="heroText" class="heroLead"></p><div id="tags" class="tags"></div><div class="heroActions"><a class="btn btnGold" href="#consult">免费鉴定</a><a class="btn btnLight" href="#consult">免费估价</a><a class="btn btnLight" id="call" href="#consult">立即咨询</a></div></div><div class="coinScene" aria-hidden="true"><div class="coin big">洪<br>盛</div><div class="coin small">藏</div><div class="note">钱币收藏</div></div></div></header><nav class="nav"><div class="wrap navInner"><div class="navBrand">洪盛集藏</div><div id="nav"></div></div></nav><main id="main" class="wrap"></main><footer class="footer"><div class="footerGrid"><div><h3 id="footName">洪盛集藏</h3><p>公益收藏资料平台 · 学习交流 · 鉴赏参考 · 市场行情</p></div><div><h3>快速导航</h3><p><a href="#market">最新价格行情</a>　<a href="#content">收藏交流</a></p><p><a href="#fujian">福建钱币</a>　<a href="#consult">免费咨询</a></p></div><div><h3>联系我们</h3><p id="footPhone"></p><p>福建省泉州市后城旅游文化街179号</p></div></div><div class="copy">本站为钱币收藏交流平台，资料仅供学习交流参考。投资有风险，入市需谨慎。 © 2026 洪盛集藏</div></footer><script>const E=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));const esc=s=>encodeURIComponent(s);function pathFor(id){if(id.startsWith('market_'))return'data/market/'+id.slice(7)+'.json';if(id.startsWith('fujian_'))return'data/market/'+id+'.json';return'data/content/'+id+'.json'}async function load(id){try{const r=await fetch(pathFor(id)+'?t='+Date.now(),{cache:'no-store'});if(!r.ok)return[];const a=await r.json();return Array.isArray(a)?a:[]}catch(e){return[]}}function iconFor(n){if(n.includes('银元')||n.includes('机制币'))return'🥈';if(n.includes('铜钱'))return'🪙';if(n.includes('铜元')||n.includes('铜币'))return'🪙';if(n.includes('纸币'))return'💴';if(n.includes('福建'))return'🏮';if(n.includes('知识'))return'📚';if(n.includes('历史'))return'📖';return'🔎'}function card(x,id,isPrice){const img=Array.isArray(x.images)&&x.images[0]?x.images[0]:'';return'<article class="card"><a href="detail.html?cat='+esc(id)+'&id='+esc(x.id)+'">'+(img?'<img src="'+E(img)+'" loading="lazy" alt="'+E(x.title||'钱币资料')+'">':'<div style="aspect-ratio:4/3;background:linear-gradient(145deg,#7a1812,#b99550);display:grid;place-items:center;color:#fff1c9;font-family:serif;font-size:42px">'+iconFor(id)+'</div>')+'<div class="body"><div class="meta">'+E(id.startsWith('fujian_')?'福建钱币':id)+'　'+E(x.date||'')+'</div><h3>'+E(x.title||'未命名资料')+'</h3>'+(isPrice&&x.price?'<div class="price">参考价格：'+E(x.price)+'</div>':'')+'<div class="text">'+E(x.note||x.content||'')+'</div><span class="more">查看详情 →</span></div></a></article>'}async function renderDataItem(item,isPrice){const a=(await load(item.id)).filter(x=>x.status!=='hidden').sort((x,y)=>String(y.date||'').localeCompare(String(x.date||'')));if(!a.length)return'';return'<div class="categoryBlock"><div class="categoryHead"><h3 class="categoryTitle">'+E(item.name)+'</h3><span class="count">'+a.length+' 条资料</span></div><div class="cards">'+a.slice(0,8).map(x=>card(x,item.id,isPrice)).join('')+'</div></div>'}async function renderGroup(gid,g){const items=(g.items||[]).filter(x=>x.enabled);const parts=await Promise.all(items.map(x=>renderDataItem(x,gid==='market')));return parts.filter(Boolean).join('')||'<div class="categoryBlock"><div class="emptySection">暂无已发布资料，发布后会自动显示在对应版块。</div></div>'}async function boot(){let c;try{c=await(await fetch('data/site-config.json?t='+Date.now(),{cache:'no-store'})).json()}catch(e){document.getElementById('main').innerHTML='<section class="section"><div class="notice"><h2>网站配置读取失败</h2><p>请稍后刷新。</p></div></section>';return}document.title=(c.siteName||'洪盛集藏')+'｜钱币收藏资料与交流平台';document.getElementById('top').textContent=c.topNotice||'';document.getElementById('brand').textContent=c.siteName||'洪盛集藏';document.getElementById('heroTitle').textContent=c.heroTitle||'专业的钱币收藏交流平台';document.getElementById('heroText').textContent=c.heroText||'';document.getElementById('call').href='tel:'+(c.phone||'');document.getElementById('footName').textContent=c.siteName||'洪盛集藏';document.getElementById('footPhone').textContent='电话 / 微信：'+(c.phone||'');const enabledGroups=Object.entries(c.groups||{}).filter(([id,g])=>g&&g.items);document.getElementById('tags').innerHTML=enabledGroups.flatMap(([id,g])=>(g.items||[]).filter(x=>x.enabled).slice(0,2).map(x=>'<span class="tag">'+E(x.name)+'</span>')).slice(0,7).join('');document.getElementById('nav').innerHTML=(c.nav||[]).filter(x=>x.enabled).map(x=>'<a href="#'+E(x.id)+'">'+E(x.name)+'</a>').join('');const main=document.getElementById('main');let html='';const market=c.groups&&c.groups.market;const content=c.groups&&c.groups.content;const fujian=c.groups&&c.groups.fujian;let tiles=[];if(market)tiles=tiles.concat((market.items||[]).filter(x=>x.enabled));if(content)tiles=tiles.concat((content.items||[]).filter(x=>x.enabled).slice(0,2));if(fujian)tiles=tiles.concat([{id:'fujian',name:'福建钱币',enabled:true}]);html+='<section class="section"><div class="categoryTiles">'+tiles.slice(0,6).map((x,i)=>'<a class="tile '+(i===0?'primary':'')+'" href="#'+E(x.id.startsWith('market_')?'market':x.id==='fujian'?'fujian':'content')+'"><div class="tileIcon">'+iconFor(x.name)+'</div><div class="tileTitle">'+E(x.name.replace('行情',''))+'</div><div class="tileMore">查看更多 ›</div></a>').join('')+'</div><div class="contentGrid"><div class="miniPanel marketBox"><div class="miniHead"><h3>最新价格行情</h3><a href="#market">查看更多 ›</a></div><table class="marketTable"><thead><tr><th>资料类别</th><th>状态</th><th>参考</th></tr></thead><tbody><tr><td>银元 · 机制币</td><td>行情资料</td><td>按资料显示</td></tr><tr><td>铜钱</td><td>行情资料</td><td>按资料显示</td></tr><tr><td>铜元</td><td>行情资料</td><td>按资料显示</td></tr><tr><td>纸币</td><td>行情资料</td><td>按资料显示</td></tr></tbody></table></div><div class="miniPanel"><div class="miniHead"><h3>收藏知识</h3><a href="#content">查看更多 ›</a></div><ul class="knowledgeList"><li>钱币收藏入门基础知识</li><li>品相、版别与真伪参考</li><li>钱币保存与保养方法</li><li>收藏文化与历史研究</li><li>评级知识与送评交流</li></ul></div><div class="miniPanel"><div class="miniHead"><h3>平台服务</h3><a href="#consult">立即咨询 ›</a></div><ul class="serviceList"><li>免费鉴赏参考</li><li>品相分析参考</li><li>市场行情交流</li><li>收藏经验交流</li><li>真伪知识学习</li></ul></div></div></section>';for(const [gid,g] of enabledGroups){html+='<section id="'+E(gid)+'" class="section"><div class="panel"><div class="kicker">'+E(gid==='market'?'MARKET REFERENCE':gid==='fujian'?'FUJIAN NUMISMATICS':'COLLECTION · APPRECIATION · RESEARCH')+'</div><h2 class="sectionTitle">'+E(g.title)+'</h2><p class="sub">'+E(g.subtitle||'')+'</p><div class="rule"></div>'+await renderGroup(gid,g)+'</div></section>'}if(c.consult&&c.consult.enabled)html+='<section id="consult" class="section"><div class="notice"><div class="kicker">FREE CONSULTATION</div><h2>'+E(c.consult.title||'免费鉴定 · 免费估价 · 立即咨询')+'</h2>'+String(c.consult.text||'').split('\n').map(x=>'<p>'+E(x)+'</p>').join('')+'<p><strong>电话 / 微信：'+E(c.phone||'')+'</strong></p><a class="btn btnGold" href="tel:'+E(c.phone||'')+'">☎ 立即咨询</a></div><div class="important"><div><b>交流学习</b><span>仅供学习交流参考</span></div><div><b>非盈利性</b><span>公益平台 · 非盈利机构</span></div><div><b>理性收藏</b><span>理性收藏，量力而行</span></div><div><b>风险提示</b><span>投资有风险，入市需谨慎</span></div></div></section>';main.innerHTML=html}boot();</script></body></html>